# Copy to .env and fill in. Never commit .env.

# Anthropic API key used by the Claude Agent SDK (agent process).
ANTHROPIC_API_KEY=

# OpenWeatherMap API key used by the OpenWeather MCP server (existing server).
OWM_API_KEY=

# Absolute path to the mcp-openweather binary (built from
# https://github.com/mschneider82/mcp-openweather). Example:
# OPENWEATHER_MCP_BIN=C:\tools\mcp-weather\mcp-weather.exe
OPENWEATHER_MCP_BIN=

# Set to 1 to serve recorded OpenWeather fixtures instead of live calls.
REPLAY=0
